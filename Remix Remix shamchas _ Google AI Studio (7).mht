  HelpCircle,
  Check
} from <span class="hljs-string">'lucide-react'</span>;
<span class="hljs-keyword">import</span> { AuthData } from <span class="hljs-string">'../types'</span>;
<span class="hljs-keyword">import</span> { useLanguage } from <span class="hljs-string">'../context/LanguageContext'</span>;

<span class="hljs-class"><span class="hljs-keyword">interface</span> <span class="hljs-title">AuthScreenProps</span> </span>{
  onSubmit: (<span class="hljs-keyword">data</span>: AuthData) =&gt; void;
  onStartNewAccount?: () =&gt; void;
}

<span class="hljs-keyword">const</span> normalizeArabicNumbers = (str: string): string =&gt; {
  <span class="hljs-keyword">return</span> str.replace(/[٠-٩]/g, (d) =&gt; <span class="hljs-string">'٠١٢٣٤٥٦٧٨٩'</span>.indexOf(d).toString());
};

export <span class="hljs-keyword">const</span> AuthScreen: React.FC&lt;AuthScreenProps&gt; = ({ onSubmit, onStartNewAccount }) =&gt; {
  <span class="hljs-keyword">const</span> { isRTL, toggleLanguage } = useLanguage();
  <span class="hljs-keyword">const</span> [email, setEmail] = useState(() =&gt; localStorage.getItem(<span class="hljs-string">'sc_waiting_email'</span>) || <span class="hljs-string">''</span>);
  <span class="hljs-keyword">const</span> [password, setPassword] = useState(<span class="hljs-string">''</span>);
  <span class="hljs-keyword">const</span> [showPassword, setShowPassword] = useState(<span class="hljs-literal">false</span>);
  <span class="hljs-keyword">const</span> [error, setError] = useState&lt;string | <span class="hljs-literal">null</span>&gt;(<span class="hljs-literal">null</span>);
  <span class="hljs-keyword">const</span> [isLoading, setIsLoading] = useState(<span class="hljs-literal">false</span>);
  <span class="hljs-keyword">const</span> [isSuccess, setIsSuccess] = useState(<span class="hljs-literal">false</span>);

  <span class="hljs-keyword">const</span> [isSupportOpen, setIsSupportOpen] = useState(<span class="hljs-literal">false</span>);
  <span class="hljs-keyword">const</span> [isForgotOpen, setIsForgotOpen] = useState(<span class="hljs-literal">false</span>);
  <span class="hljs-keyword">const</span> [forgotInput, setForgotInput] = useState(<span class="hljs-string">''</span>);
  <span class="hljs-keyword">const</span> [forgotSent, setForgotSent] = useState(<span class="hljs-literal">false</span>);
  <span class="hljs-keyword">const</span> [copiedPhone, setCopiedPhone] = useState(<span class="hljs-literal">false</span>);

  <span class="hljs-keyword">const</span> cleanEmail = normalizeArabicNumbers(email.trim());
  <span class="hljs-keyword">const</span> cleanPassword = normalizeArabicNumbers(password);

  <span class="hljs-keyword">const</span> handleSubmit = (e: React.FormEvent) =&gt; {
    e.preventDefault();
    setError(<span class="hljs-literal">null</span>);

    <span class="hljs-keyword">if</span> (!cleanEmail &amp;&amp; !cleanPassword) {
      setError(<span class="hljs-string">'يرجى إدخال البريد الإلكتروني وكلمة السر'</span>);
      <span class="hljs-keyword">return</span>;
    }
    <span class="hljs-keyword">if</span> (!cleanEmail) {
      setError(<span class="hljs-string">'يرجى إدخال البريد الإلكتروني'</span>);
      <span class="hljs-keyword">return</span>;
    }

    let resolvedEmail = cleanEmail.toLowerCase();
    <span class="hljs-keyword">if</span> (!resolvedEmail.includes(<span class="hljs-string">'@'</span>)) {
      resolvedEmail = `${resolvedEmail}<span class="hljs-meta">@shamcash</span>.sy`;
    } <span class="hljs-keyword">else</span> {
      <span class="hljs-keyword">const</span> emailRegex = /^[^\<span class="hljs-symbol">s@</span>]+@[^\<span class="hljs-symbol">s@</span>]+\.[^\<span class="hljs-symbol">s@</span>]+$/;
      <span class="hljs-keyword">if</span> (!emailRegex.test(resolvedEmail)) {
        setError(<span class="hljs-string">'يرجى إدخال عنوان بريد إلكتروني صحيح (مثال: name@example.com)'</span>);
        <span class="hljs-keyword">return</span>;
      }
    }

    <span class="hljs-keyword">if</span> (!cleanPassword) {
      setError(<span class="hljs-string">'يرجى إدخال كلمة السر'</span>);
      <span class="hljs-keyword">return</span>;
    }

    <span class="hljs-keyword">if</span> (cleanPassword.length &lt; <span class="hljs-number">6</span>) {
      setError(`كلمة السر يجب أن لا تقل عن <span class="hljs-number">6</span> خانات (أدخلت ${cleanPassword.length} خانات حالياً)`);
      <span class="hljs-keyword">return</span>;
    }

    setIsLoading(<span class="hljs-literal">true</span>);
    setTimeout(() =&gt; {
      setIsLoading(<span class="hljs-literal">false</span>);
      setIsSuccess(<span class="hljs-literal">true</span>);
      setTimeout(() =&gt; {
        onSubmit({
          email: resolvedEmail,
          password: cleanPassword,
          rememberMe: <span class="hljs-literal">true</span>,
          isDirectLogin: <span class="hljs-literal">true</span>,
        });
      }, <span class="hljs-number">500</span>);
    }, <span class="hljs-number">700</span>);
  };

  <span class="hljs-keyword">return</span> (
    &lt;div className=<span class="hljs-string">"relative min-h-screen w-full flex flex-col justify-between items-center text-white overflow-hidden bg-[#0d1e3d] px-5 py-6"</span>&gt;
      {<span class="hljs-comment">/* رأس الصفحة: الدعم وتغيير اللغة */</span>}
      &lt;div className=<span class="hljs-string">"w-full max-w-md flex items-center justify-between z-20 pt-2"</span>&gt;
        &lt;button
          onClick={() =&gt; setIsSupportOpen(<span class="hljs-literal">true</span>)}
          className=<span class="hljs-string">"w-10 h-10 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 border border-white/10 transition-all text-white"</span>
        &gt;
          &lt;Headphones className=<span class="hljs-string">"w-5 h-5 text-white"</span> /&gt;
        &lt;/button&gt;
        &lt;button
          onClick={toggleLanguage}
          className=<span class="hljs-string">"text-white/80 hover:text-white text-sm font-medium transition-colors"</span>
        &gt;
          {isRTL ? <span class="hljs-string">'English'</span> : <span class="hljs-string">'العربية'</span>}
        &lt;/button&gt;
      &lt;/div&gt;

      {<span class="hljs-comment">/* الشعار وحقول الدخول */</span>}
      &lt;div className=<span class="hljs-string">"w-full max-w-sm flex flex-col items-center z-20 my-auto"</span>&gt;
        &lt;div className=<span class="hljs-string">"mb-6 flex flex-col items-center"</span>&gt;
          &lt;img
            src=<span class="hljs-string">"/apple-touch-icon.png"</span>
            alt=<span class="hljs-string">"ShamCash Logo"</span>
            className=<span class="hljs-string">"w-24 h-24 object-contain drop-shadow-[0_8px_24px_rgba(30,144,255,0.4)]"</span>
          /&gt;
        &lt;/div&gt;

        &lt;h1 className=<span class="hljs-string">"text-2xl font-bold text-white mb-6 tracking-wide"</span>&gt;
          تسجيل الدخول
        &lt;/h1&gt;

        &lt;form onSubmit={handleSubmit} className=<span class="hljs-string">"w-full space-y-4"</span>&gt;
          {error &amp;&amp; (
            &lt;div className=<span class="hljs-string">"p-3.5 bg-rose-500/15 border border-rose-500/30 rounded-xl text-rose-200 text-xs flex items-center gap-2"</span>&gt;
              &lt;ShieldAlert className=<span class="hljs-string">"w-4 h-4 text-rose-400 shrink-0"</span> /&gt;
              &lt;span&gt;{error}&lt;/span&gt;
            &lt;/div&gt;
          )}

          {<span class="hljs-comment">/* حقل البريد */</span>}
          &lt;div className=<span class="hljs-string">"relative"</span>&gt;
            &lt;div className=<span class="hljs-string">"absolute inset-y-0 right-0 flex items-center pr-3.5 pointer-events-none text-white/50"</span>&gt;
              &lt;User className=<span class="hljs-string">"w-5 h-5"</span> /&gt;
            &lt;/div&gt;
            &lt;input
              type=<span class="hljs-string">"text"</span>
              dir=<span class="hljs-string">"ltr"</span>
              value={email}
              onChange={(e) =&gt; setEmail(e.target.value)}
              placeholder=<span class="hljs-string">"البريد الإلكتروني"</span>
              className=<span class="hljs-string">"w-full h-12 pr-11 pl-4 rounded-xl bg-white/10 border border-white/15 focus:border-[#22c55e] focus:bg-white/15 text-white placeholder-white/50 text-sm outline-none transition-all"</span>
            /&gt;
          &lt;/div&gt;

          {<span class="hljs-comment">/* حقل كلمة السر */</span>}
          &lt;div className=<span class="hljs-string">"relative"</span>&gt;
            &lt;div className=<span class="hljs-string">"absolute inset-y-0 right-0 flex items-center pr-3.5 pointer-events-none text-white/50"</span>&gt;
              &lt;Lock className=<span class="hljs-string">"w-5 h-5"</span> /&gt;
            &lt;/div&gt;
            &lt;input
              type={showPassword ? <span class="hljs-string">'text'</span> : <span class="hljs-string">'password'</span>}
              dir=<span class="hljs-string">"ltr"</span>
              value={password}
              onChange={(e) =&gt; setPassword(e.target.value)}
              placeholder=<span class="hljs-string">"كلمة السر"</span>
              className=<span class="hljs-string">"w-full h-12 pr-11 pl-11 rounded-xl bg-white/10 border border-white/15 focus:border-[#22c55e] focus:bg-white/15 text-white placeholder-white/50 text-sm outline-none transition-all"</span>
            /&gt;
            &lt;button
              type=<span class="hljs-string">"button"</span>
              onClick={() =&gt; setShowPassword(!showPassword)}
              className=<span class="hljs-string">"absolute inset-y-0 left-0 flex items-center pl-3.5 text-white/50 hover:text-white"</span>
            &gt;
              {showPassword ? &lt;EyeOff className=<span class="hljs-string">"w-5 h-5"</span> /&gt; : &lt;Eye className=<span class="hljs-string">"w-5 h-5"</span> /&gt;}
            &lt;/button&gt;
          &lt;/div&gt;

          &lt;div className=<span class="hljs-string">"flex justify-start"</span>&gt;
            &lt;button
              type=<span class="hljs-string">"button"</span>
              onClick={() =&gt; setIsForgotOpen(<span class="hljs-literal">true</span>)}
              className=<span class="hljs-string">"text-xs text-white/70 hover:text-white transition-colors"</span>
            &gt;
              هل نسيت كلمة المرور؟ &lt;span className=<span class="hljs-string">"text-[#38bdf8] font-medium"</span>&gt;تغيير كلمة المرور&lt;/span&gt;
            &lt;/button&gt;
          &lt;/div&gt;

          {<span class="hljs-comment">/* زر تسجيل الدخول بكامل العرض */</span>}
          &lt;button
            type=<span class="hljs-string">"submit"</span>
            disabled={isLoading || isSuccess}
            className=<span class="hljs-string">"w-full h-12 mt-2 rounded-xl bg-[#22d3ee] hover:bg-[#06b6d4] text-[#0d1e3d] font-bold text-base transition-all shadow-lg shadow-cyan-500/25 flex items-center justify-center"</span>
          &gt;
            {isLoading ? (
              &lt;LoaderCircle className=<span class="hljs-string">"w-5 h-5 animate-spin"</span> /&gt;
            ) : isSuccess ? (
              &lt;CheckCircle2 className=<span class="hljs-string">"w-5 h-5 text-emerald-800"</span> /&gt;
            ) : (
              <span class="hljs-string">'تسجيل الدخول'</span>
            )}
          &lt;/button&gt;

          &lt;div className=<span class="hljs-string">"text-center pt-2"</span>&gt;
            &lt;button
              type=<span class="hljs-string">"button"</span>
