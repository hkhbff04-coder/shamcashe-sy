              className=<span class="hljs-string">"text-xs text-white/80 hover:text-white transition-colors"</span>
            &gt;
              لا تملك حساب مسبقاً؟ &lt;span className=<span class="hljs-string">"text-[#38bdf8] font-semibold"</span>&gt;إنشاء حساب&lt;/span&gt;
            &lt;/button&gt;
          &lt;/div&gt;
        &lt;/form&gt;
      &lt;/div&gt;

      {<span class="hljs-comment">/* أسفل الصفحة: الإصدار */</span>}
      &lt;div className=<span class="hljs-string">"flex flex-col items-center text-center z-20 pt-6 pb-2"</span>&gt;
        &lt;p className=<span class="hljs-string">"text-[11px] font-semibold tracking-wider text-white/50 uppercase"</span>&gt;POWERED BY&lt;/p&gt;
        &lt;p className=<span class="hljs-string">"text-[10px] text-white/40 mt-0.5 font-mono"</span>&gt;shamcash <span class="hljs-number">3.0</span><span class="hljs-number">.2</span>&lt;/p&gt;
